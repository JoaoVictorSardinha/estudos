LAB_MACHINES = [
  { name: "ansible", hostname: "ansible.lab.example", ip: "192.168.122.10", memory: 2048, cpus: 2 },
  { name: "servera", hostname: "servera.lab.example.com", ip: "192.168.122.11" },
  { name: "serverb", hostname: "serverb.lab.example.com", ip: "192.168.122.12" },
  { name: "serverc", hostname: "serverc.lab.example.com", ip: "192.168.122.13" },
  { name: "serverd", hostname: "serverd.lab.example.com", ip: "192.168.122.14" },
  { name: "servere", hostname: "servere.lab.example.com", ip: "192.168.122.15" }
].freeze
LAB_HOSTS = LAB_MACHINES.map do |machine|
  short_hostname = machine[:hostname].split(".").first

  "#{machine[:ip]} #{short_hostname} #{machine[:hostname]}"
end.join("\n")

RHEL_ISO_SOURCE = ENV["ISO"].to_s
RH_USER = ENV["RH_USER"].to_s
RH_TOKEN = ENV["RH_TOKEN"].to_s
RHSM_ORG = ENV["RHSM_ORG"].to_s
RHSM_ACTIVATION_KEY = ENV["RHSM_ACTIVATION_KEY"].to_s

Vagrant.configure("2") do |config|
  config.ssh.insert_key = false
  config.vm.box_check_update = false
  config.vm.box_version = "1.0.0"
  config.vm.boot_timeout = 600
  config.vm.synced_folder ".", "/vagrant", type: "rsync", rsync__exclude: ".git/"

  kvm_available = File.exist?("/dev/kvm")
  libvirt_driver = kvm_available ? "kvm" : "qemu"

  LAB_MACHINES.each do |machine|
    config.vm.define machine[:name] do |node|
      node.vm.box = "jvms-rhel/rhel9"
      node.vm.box_version = "1.0.0"
      node.vm.hostname = machine[:hostname]
      node.vm.network :private_network,
                      ip: machine[:ip],
                      libvirt__network_name: "default",
                      libvirt__always_destroy: false

      node.vm.provider "libvirt" do |libvirt|
        libvirt.uri = "qemu:///system"
        libvirt.driver = libvirt_driver
        libvirt.memory = machine.fetch(:memory, 2048)
        libvirt.cpus = machine.fetch(:cpus, 2)
        libvirt.management_network_device = "virbr1"
        libvirt.management_network_name = "vagrant-libvirt"
        libvirt.management_network_address = "192.168.121.0/24"
        libvirt.management_network_keep = true
      end

      node.vm.provision :shell,
                        env: { "LAB_HOSTS" => LAB_HOSTS },
                        inline: <<-'SHELL'
        set -euo pipefail

        # Habilita login por senha
        sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
        systemctl restart sshd

        # Cria usuário student
        id student &>/dev/null || useradd -m student

        echo 'redhat' | passwd --stdin student

        # Sudo sem senha
        echo 'student ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/student
        chmod 440 /etc/sudoers.d/student

        # Copia chave SSH do usuário vagrant
        mkdir -p /home/student/.ssh

        if [ -f /home/vagrant/.ssh/authorized_keys ]; then
          cp /home/vagrant/.ssh/authorized_keys /home/student/.ssh/
        fi

        chown -R student:student /home/student/.ssh
        chmod 700 /home/student/.ssh

        if [ -f /home/student/.ssh/authorized_keys ]; then
          chmod 600 /home/student/.ssh/authorized_keys
        fi

        sed -i '/ lab-managed$/d' /etc/hosts
        while IFS= read -r host_entry; do
          [ -n "${host_entry}" ] && echo "${host_entry} lab-managed" >> /etc/hosts
        done <<< "${LAB_HOSTS}"
      SHELL

      if machine[:name] == "ansible"
        node.vm.provision :shell,
                          env: {
                            "RHEL_ISO_SOURCE" => RHEL_ISO_SOURCE,
                            "RH_USER" => RH_USER,
                            "RH_TOKEN" => RH_TOKEN,
                            "RHSM_ORG" => RHSM_ORG,
                            "RHSM_ACTIVATION_KEY" => RHSM_ACTIVATION_KEY
                          },
                          inline: <<-'SHELL'
          set -euo pipefail

          if [ -z "${RHEL_ISO_SOURCE}" ]; then
            echo "ISO must be set with the host path to the RHEL ISO." >&2
            exit 1
          fi

          iso_device=""
          for candidate in /dev/sr0 /dev/cdrom /dev/disk/by-label/*; do
            if [ -e "${candidate}" ] && blkid "${candidate}" 2>/dev/null | grep -q 'TYPE="iso9660"'; then
              iso_device="${candidate}"
              break
            fi
          done

          if [ -z "${iso_device}" ]; then
            iso_device="$(blkid -t TYPE=iso9660 -o device | head -n 1 || true)"
          fi

          if [ -z "${iso_device}" ]; then
            echo "No attached iso9660 CD-ROM was found. Check the ISO env path on the host." >&2
            exit 1
          fi

          mkdir -p /opt/rhce /var/ftp/rhel9

          iso_mount_options="ro,context=system_u:object_r:public_content_t:s0"

          if mountpoint -q /var/ftp/rhel9 && ! ls -Zd /var/ftp/rhel9 | grep -q 'public_content_t'; then
            umount /var/ftp/rhel9
          fi

          if ! mountpoint -q /var/ftp/rhel9; then
            mount -o "${iso_mount_options}" "${iso_device}" /var/ftp/rhel9
          fi

          sed -i '\# /var/ftp/rhel9 #d' /etc/fstab
          echo "${iso_device} /var/ftp/rhel9 iso9660 ${iso_mount_options},nofail 0 0" >> /etc/fstab

          if [ -n "${RHSM_ORG}" ] && [ -n "${RHSM_ACTIVATION_KEY}" ]; then
            if ! subscription-manager identity >/dev/null 2>&1; then
              subscription-manager register \
                --org="${RHSM_ORG}" \
                --activationkey="${RHSM_ACTIVATION_KEY}"
            fi

            subscription-manager config --rhsm.manage_repos=1
          elif [ -n "${RH_USER}" ] && [ -n "${RH_TOKEN}" ]; then
            if ! subscription-manager identity >/dev/null 2>&1; then
              subscription-manager register \
                --username="${RH_USER}" \
                --password="${RH_TOKEN}" \
                --auto-attach
            fi

            subscription-manager config --rhsm.manage_repos=1
          fi

          dnf install -y \
            ansible-core \
            git \
            sshpass \
            vsftpd \
            python3-libselinux \
            python3-libsemanage

          sed -i \
            -e 's/^#\?anonymous_enable=.*/anonymous_enable=YES/' \
            -e 's/^#\?write_enable=.*/write_enable=NO/' \
            /etc/vsftpd/vsftpd.conf

          systemctl enable --now vsftpd

          if systemctl is-active --quiet firewalld; then
            firewall-cmd --permanent --add-service=ftp
            firewall-cmd --reload
          fi

          mkdir -p /home/student/ansible/{roles,collections}

          chown -R student:student /home/student/ansible
        SHELL

        if ENV["RUN_ANSIBLE_LOCAL"] == "1"
          node.vm.provision :ansible_local do |ansible|
            ansible.compatibility_mode = "2.0"
            ansible.config_file = "/vagrant/ansible.cfg"
            ansible.inventory_path = "/vagrant/inventory"
            ansible.limit = "all"
            ansible.playbook = "/vagrant/playbooks/master.yml"
            ansible.install = false
          end
        end
      else
        node.vm.provision :shell, inline: <<-'SHELL'
          set -euo pipefail

          # cat > /etc/yum.repos.d/rhel9-iso.repo <<'EOF'
          # [rhel9-baseos-iso]
          # name=RHEL 9 BaseOS ISO
          # baseurl=ftp://192.168.122.10/rhel9/BaseOS
          # enabled=1
          # gpgcheck=0
          #
          # [rhel9-appstream-iso]
          # name=RHEL 9 AppStream ISO
          # baseurl=ftp://192.168.122.10/rhel9/AppStream
          # enabled=1
          # gpgcheck=0
          # EOF

          # for attempt in {1..60}; do
          #   if dnf -q makecache --disablerepo='*' --enablerepo='rhel9-*-iso'; then
          #     break
          #   fi
          #
          #   if [ "${attempt}" -eq 60 ]; then
          #     echo "Timed out waiting for the RHEL ISO FTP repository on ansible." >&2
          #     exit 1
          #   fi
          #
          #   sleep 10
          # done
        SHELL
      end
    end
  end
end
