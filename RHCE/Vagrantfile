LAB_MACHINES = [
  { name: "ansible", hostname: "ansible.lab.example", ip: "192.168.122.10", memory: 2048, cpus: 2 },
  { name: "node1", hostname: "node1.lab.example.com", ip: "192.168.122.11" },
  { name: "node2", hostname: "node2.lab.example.com", ip: "192.168.122.12" },
  { name: "node3", hostname: "node3.lab.example.com", ip: "192.168.122.13" },
  { name: "node4", hostname: "node4.lab.example.com", ip: "192.168.122.14", lvm_disk_size: "2G" },
  { name: "node5", hostname: "node5.lab.example.com", ip: "192.168.122.15", lvm_disk_size: "1G" }
].freeze
LAB_HOSTS = LAB_MACHINES.map do |machine|
  short_hostname = machine[:hostname].split(".").first

  "#{machine[:ip]} #{short_hostname} #{machine[:hostname]}"
end.join("\n")
RHEL_ISO_SOURCE = ENV["ISO"].to_s
RH_USER = ENV["RH_USER"].to_s
RH_TOKEN = ENV["RH_TOKEN"].to_s
RHSM_ORG = ENV["RHSM_ORG"].to_s
RHSM_ACTIVATION_KEY = ENV["RHSM_ACTIVATION_KEY"].to_s

Vagrant.configure("2") do |config|
  config.ssh.insert_key = false
  config.ssh.keys_only = true
  config.ssh.forward_agent = false
  config.vm.box_check_update = false
  config.vm.box_version = "1.0.0"
  config.vm.boot_timeout = 600
  config.vm.synced_folder ".", "/vagrant", type: "rsync", rsync__exclude: ".git/"

  kvm_available = File.exist?("/dev/kvm")
  libvirt_driver = kvm_available ? "kvm" : "qemu"

  LAB_MACHINES.each do |machine|
    config.vm.define machine[:name] do |node|
      node.vm.box = "jvms-rhel/rhel9"
      node.vm.box_version = "1.0.0"
      node.vm.hostname = machine[:hostname]

      # O box "jvms-rhel/rhel9" ainda traz o usuário padrao "vagrant". O
      # provisionamento renomeia "vagrant" -> "joao" (mesmo UID/GID e chave SSH).
      # Enquanto esse marcador (criado no host apos o primeiro provision) nao
      # existir, o Vagrant loga como "vagrant"; depois passa a logar como "joao".
      joao_marker = File.join(__dir__, ".vagrant", "machines", machine[:name].to_s, "joao_renamed")
      node.ssh.username = File.exist?(joao_marker) ? "joao" : "vagrant"

      node.trigger.after :provision do |trigger|
        trigger.info = "Registrando renomeacao vagrant -> joao (#{machine[:name]})"
        trigger.run = {
          inline: %(/bin/sh -c 'mkdir -p "#{File.dirname(joao_marker)}" && touch "#{joao_marker}"')
        }
      end

      node.vm.network :private_network,
                      ip: machine[:ip],
                      libvirt__network_name: "default",
                      libvirt__always_destroy: false

      node.vm.provider "libvirt" do |libvirt|
        libvirt.uri = "qemu:///system"
        libvirt.driver = libvirt_driver
        libvirt.memory = machine.fetch(:memory, 2048)
        libvirt.cpus = machine.fetch(:cpus, 2)
        libvirt.management_network_device = "virbr1"
        libvirt.management_network_name = "vagrant-libvirt"
        libvirt.management_network_address = "192.168.121.0/24"
        libvirt.management_network_keep = true

        if machine[:lvm_disk_size]
          libvirt.storage :file,
                          size: machine[:lvm_disk_size],
                          device: "vdb",
                          bus: "virtio",
                          type: "qcow2"
        end
      end

      node.vm.provision :shell,
                        env: { "LAB_HOSTS" => LAB_HOSTS },
                        inline: <<-'SHELL'
        set -euo pipefail

        # Habilita login por senha
        sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
        systemctl restart sshd

        # Cria usuario admin (senha: redhat, sudo sem senha)
        id admin &>/dev/null || useradd -m admin

        echo 'redhat' | passwd --stdin admin

        echo 'admin ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/admin
        chmod 440 /etc/sudoers.d/admin

        sed -i '/ lab-managed$/d' /etc/hosts
        while IFS= read -r host_entry; do
          [ -n "${host_entry}" ] && echo "${host_entry} lab-managed" >> /etc/hosts
        done <<< "${LAB_HOSTS}"
      SHELL

      # Acesso SSH do usuario admin ja pronto (como no exame): a chave do lab fica
      # autorizada em todas as VMs; a control node ganha a chave privada, um
      # ~/.ssh/config sem prompt de fingerprint e o known_hosts pre-populado.
      node.vm.provision :shell,
                        name: "ssh-admin-access",
                        env: {
                          "IS_CONTROL" => (machine[:name] == "ansible" ? "1" : ""),
                          "LAB_HOSTS" => LAB_HOSTS
                        },
                        inline: <<-'SHELL'
        set -euo pipefail

        pub="$(cat /vagrant/files/lab_admin_key.pub)"

        install -d -m 700 -o admin -g admin /home/admin/.ssh

        touch /home/admin/.ssh/authorized_keys
        grep -qxF "${pub}" /home/admin/.ssh/authorized_keys \
          || echo "${pub}" >> /home/admin/.ssh/authorized_keys
        chmod 600 /home/admin/.ssh/authorized_keys
        chown admin:admin /home/admin/.ssh/authorized_keys

        if [ -n "${IS_CONTROL}" ]; then
          install -m 600 -o admin -g admin /vagrant/files/lab_admin_key     /home/admin/.ssh/id_ed25519
          install -m 644 -o admin -g admin /vagrant/files/lab_admin_key.pub /home/admin/.ssh/id_ed25519.pub

          cat > /home/admin/.ssh/config <<'EOF'
Host ansible node1 node2 node3 node4 node5 *.lab.example.com *.lab.example 192.168.122.*
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts
EOF
          chmod 600 /home/admin/.ssh/config
          chown admin:admin /home/admin/.ssh/config

          touch /home/admin/.ssh/known_hosts
          while IFS= read -r entry; do
            [ -n "${entry}" ] || continue
            for name in ${entry}; do
              ssh-keyscan -T 5 "${name}" 2>/dev/null >> /home/admin/.ssh/known_hosts || true
            done
          done <<< "${LAB_HOSTS}"
          sort -u -o /home/admin/.ssh/known_hosts /home/admin/.ssh/known_hosts
          chmod 644 /home/admin/.ssh/known_hosts
          chown admin:admin /home/admin/.ssh/known_hosts
        fi

        restorecon -RF /home/admin/.ssh 2>/dev/null || true
      SHELL

      if machine[:name] == "ansible"
        node.vm.provision :shell,
                          env: {
                            "RHEL_ISO_SOURCE" => RHEL_ISO_SOURCE,
                            "RH_USER" => RH_USER,
                            "RH_TOKEN" => RH_TOKEN,
                            "RHSM_ORG" => RHSM_ORG,
                            "RHSM_ACTIVATION_KEY" => RHSM_ACTIVATION_KEY
                          },
                          inline: <<-'SHELL'
          set -euo pipefail

          if [ -z "${RHEL_ISO_SOURCE}" ]; then
            echo "ISO must be set with the host path to the RHEL ISO." >&2
            exit 1
          fi

          iso_device=""
          for candidate in /dev/sr0 /dev/cdrom /dev/disk/by-label/*; do
            if [ -e "${candidate}" ] && blkid "${candidate}" 2>/dev/null | grep -q 'TYPE="iso9660"'; then
              iso_device="${candidate}"
              break
            fi
          done

          if [ -z "${iso_device}" ]; then
            iso_device="$(blkid -t TYPE=iso9660 -o device | head -n 1 || true)"
          fi

          if [ -z "${iso_device}" ]; then
            echo "No attached iso9660 CD-ROM was found. Check the ISO env path on the host." >&2
            exit 1
          fi

          mkdir -p /opt/rhce /var/ftp/rhel9 /var/ftp/pub

          iso_mount_options="ro,context=system_u:object_r:public_content_t:s0"

          if mountpoint -q /var/ftp/rhel9 && ! ls -Zd /var/ftp/rhel9 | grep -q 'public_content_t'; then
            umount /var/ftp/rhel9
          fi

          if ! mountpoint -q /var/ftp/rhel9; then
            mount -o "${iso_mount_options}" "${iso_device}" /var/ftp/rhel9
          fi

          sed -i '\# /var/ftp/rhel9 #d' /etc/fstab
          echo "${iso_device} /var/ftp/rhel9 iso9660 ${iso_mount_options},nofail 0 0" >> /etc/fstab

          if [ -n "${RHSM_ORG}" ] && [ -n "${RHSM_ACTIVATION_KEY}" ]; then
            if ! subscription-manager identity >/dev/null 2>&1; then
              subscription-manager register \
                --org="${RHSM_ORG}" \
                --activationkey="${RHSM_ACTIVATION_KEY}"
            fi

            subscription-manager config --rhsm.manage_repos=1
          elif [ -n "${RH_USER}" ] && [ -n "${RH_TOKEN}" ]; then
            if ! subscription-manager identity >/dev/null 2>&1; then
              subscription-manager register \
                --username="${RH_USER}" \
                --password="${RH_TOKEN}" \
                --auto-attach
            fi

            subscription-manager config --rhsm.manage_repos=1
          fi

          if sudo subscription-manager identity >/dev/null 2>&1; then
            sudo subscription-manager repos --enable ansible-automation-platform-2.7-for-rhel-9-x86_64-rpms
          fi

          dnf install -y \
            ansible-core \
            git \
            lvm2 \
            rhel-system-roles \
            sshpass \
            vim \
            vsftpd \
            wget \
            python3-libselinux \
            python3-libsemanage

          sed -i \
            -e 's/^#\?anonymous_enable=.*/anonymous_enable=YES/' \
            -e 's/^#\?write_enable=.*/write_enable=NO/' \
            /etc/vsftpd/vsftpd.conf

          systemctl enable --now vsftpd

          vault_plaintext="$(mktemp)"
          vault_password_file="$(mktemp)"
          trap 'rm -f "${vault_plaintext}" "${vault_password_file}"' EXIT

          printf '%s\n' 'salary: 50000' > "${vault_plaintext}"
          printf '%s\n' 'cisco' > "${vault_password_file}"
          chmod 600 "${vault_plaintext}" "${vault_password_file}"

          ansible-vault encrypt \
            "${vault_plaintext}" \
            --output /var/ftp/pub/salary.yml \
            --vault-password-file "${vault_password_file}"

          chown root:root /var/ftp/pub/salary.yml
          chmod 0644 /var/ftp/pub/salary.yml
          restorecon -RFv /var/ftp/pub

          if systemctl is-active --quiet firewalld; then
            firewall-cmd --permanent --add-service=ftp
            firewall-cmd --reload
          fi
        SHELL

      else
        node.vm.provision :shell, inline: <<-'SHELL'
          set -euo pipefail

          dnf install -y \
            --disablerepo='*' \
            --repofrompath='rhce-baseos,ftp://192.168.122.10/rhel9/BaseOS' \
            --repofrompath='rhce-appstream,ftp://192.168.122.10/rhel9/AppStream' \
            --setopt=rhce-baseos.gpgcheck=0 \
            --setopt=rhce-appstream.gpgcheck=0 \
            lvm2

          if command -v subscription-manager >/dev/null 2>&1 && subscription-manager identity >/dev/null 2>&1; then
            subscription-manager unregister
            subscription-manager clean
          fi
        SHELL
      end

      # Ultimo provisionador: renomeia o usuario padrao do box "vagrant" -> "joao"
      # (mesmo UID/GID e chave SSH). Fica por ultimo de proposito -- se algo antes
      # falhar, o retry ainda entra como "vagrant". Edita os arquivos diretamente
      # para nao esbarrar na checagem "user is currently logged in" do usermod,
      # ja que o provisionamento roda na propria sessao do "vagrant".
      node.vm.provision :shell, name: "rename-vagrant-user", inline: <<-'SHELL'
        set -euo pipefail

        if getent passwd vagrant >/dev/null && ! getent passwd joao >/dev/null; then
          sed -i 's/^vagrant:/joao:/'              /etc/passwd /etc/shadow
          sed -i 's#:/home/vagrant:#:/home/joao:#' /etc/passwd
          sed -i 's/vagrant/joao/g'                /etc/group /etc/gshadow
          # sed -i recria os arquivos -- restaura os contextos SELinux
          restorecon -F /etc/passwd /etc/shadow /etc/group /etc/gshadow 2>/dev/null || true
          if [ -d /home/vagrant ]; then
            mv /home/vagrant /home/joao
          fi
          if [ -f /etc/sudoers.d/vagrant ]; then
            sed 's/vagrant/joao/g' /etc/sudoers.d/vagrant > /etc/sudoers.d/joao
            rm -f /etc/sudoers.d/vagrant
            chmod 440 /etc/sudoers.d/joao
          fi
          restorecon -RF /home/joao 2>/dev/null || true
          echo "usuario 'vagrant' renomeado para 'joao'"
        else
          echo "renomeacao vagrant->joao ja aplicada (ou 'vagrant' ausente)"
        fi
      SHELL

    end
  end
end
